### Create Article
POST {{baseUrl}}/api/admin/articles
Content-Type: application/json
Accept: application/json

{
  "slug": "hello-world",
  "status": "PUBLISHED",
  "translations": [
    {
      "language": "EN",
      "title": "Hello World",
      "summary": "An example article",
      "markdown_content": "# Hello\n\nThis is an example.",
      "html_content": "<h1>Hello</h1><p>This is an example.</p>",
      "is_source": true,
      "is_translated_by_ai": false
    },
    {
      "language": "ZH",
      "title": "你好，世界",
      "summary": "示例文章",
      "markdown_content": "# 你好\n\n这是一篇示例文章。",
      "html_content": "<h1>你好</h1><p>这是一篇示例文章。</p>",
      "is_source": false,
      "is_translated_by_ai": true
    }
  ]
}

### Get by ID
GET {{baseUrl}}/api/admin/articles/1
Accept: application/json

### GET article
GET {{baseUrl}}/ZH/articles/hello-world
Accept: application/json

### List articles (default)
POST {{baseUrl}}/api/articles/query
Content-Type: application/json
Accept: application/json

{
  "language": "EN",
  "limit": 20,
  "offset": 0
}

### List articles with filters
POST {{baseUrl}}/api/articles/query
Content-Type: application/json
Accept: application/json

{
  "language": "ZH",
  "key": "示例",
  "category": "backend",
  "tag": "go",
  "limit": 10,
  "offset": 0
}

### List articles next page
POST {{baseUrl}}/api/articles/query
Content-Type: application/json
Accept: application/json

{
  "language": "EN",
  "limit": 5,
  "offset": 5
}

### List articles with unsupported language (expect 400)
POST {{baseUrl}}/api/articles/query
Content-Type: application/json
Accept: application/json

{
  "language": "FR"
}